{
  "name": "cronofree",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Local-first food + training log. Best-of MyFitnessPal, Cronometer, MacroFactor and LiftLog, in one installable app that syncs with your own computer.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "serve": "node server/index.mjs",
    "start": "npm run build && node server/index.mjs",
    "test": "node --experimental-strip-types --no-warnings --test tests/*.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "express": "^5.2.1",
    "lucide-react": "^1.47.0",
    "nanoid": "^6.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0"
  },
  "engines": { "node": ">=20" }
}
